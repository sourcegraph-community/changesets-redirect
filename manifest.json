{
  "manifest_version": 3,
  "name": "Sourcegraph changesets redirect",
  "version": "1.0.0",
  "description": "Opens sourcegraph/sourcegraph pull requests in Sourcegraph's changeset review view.",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Changesets redirect: ON (click to toggle)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
